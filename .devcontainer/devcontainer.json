{
  "name": "EduFlow 教务系统",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "nohup bash scripts/codespace_start.sh > /tmp/eduflow.log 2>&1 &",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "EduFlow Web",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "containerEnv": {
    "EDUFLOW_HOST": "0.0.0.0",
    "EDUFLOW_PORT": "8765"
  },
  "customizations": {
    "vscode": {
      "extensions": ["Vue.volar", "ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "remoteUser": "vscode"
}
